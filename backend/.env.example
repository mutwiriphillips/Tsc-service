# ── Database ──
DATABASE_URL="postgresql://tsc:CHANGE_ME@localhost:5432/tsc_tmgs?schema=public"

# ── Runtime ──
NODE_ENV=production
PORT=4000
# Only needed when the web app runs on a different address (local `npm run dev` on :3000).
# In a normal deployment the API serves the web pages itself, so there are no cross-origin calls.
CORS_ORIGIN=http://localhost:3000

# ── Secrets: generate with deploy/generate-secrets.sh. Never reuse across environments. ──
JWT_OFFICER_SECRET=
JWT_TEACHER_SECRET=
# 64 hex characters, or any random string of 32+ characters (a key is derived from it).
# Encrypts sensitive records and two-step secrets. Losing it makes those unreadable:
# keep it in a key vault and back it up separately from the database.
DATA_ENCRYPTION_KEY=
# Keyed hash for national IDs. Changing it breaks portal registration matching.
NATIONAL_ID_PEPPER=

OFFICER_TOKEN_TTL=8h
TEACHER_TOKEN_TTL=2h
# Must be true in production (the server refuses to start otherwise).
MFA_REQUIRED=true

# ── First National Admin ──
# Used only while the database has no officers. After the first sign-in, change the
# password in the app and remove BOOTSTRAP_ADMIN_PASSWORD from the environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=National Administrator
BOOTSTRAP_ADMIN_STAFF_NUMBER=HQ-0001

# ── Compliance scan schedule (runs inside the app) ──
RULES_INTERVAL_HOURS=24
# Set to "off" if an external scheduler runs scripts/run-rules.js instead.
RULES_SCHEDULER=on

# Where the exported web app lives. Default: ../frontend/out
# WEB_DIR=
